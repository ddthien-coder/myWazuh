<group name="zeek,">
  <rule id="100900" level="0">
    <decoded_as>json</decoded_as>
    <description>Zeek alerts</description>
  </rule>

  <rule id="100901" level="5">
    <if_sid>100900</if_sid>
    <field name="dnsquery">\w+.</field>
    <dstport type="pcre2">^53$</dstport>
    <field name="resolved_by">\d+.\d+.\d+.\d+</field>
    <description>Zeek: DNS Query $(dnsquery) attempted from source ip $(srcip) source port $(srcport) resolved to IP(s) $(resolved_by)</description>
  </rule>

  <rule id="100902" level="0">
    <if_sid>100900</if_sid>
    <srcport>5353</srcport>
    <description>Zeek: Normal mDNS traffic - $(dnsquery) from source ip $(srcip). Generally benign. Investigate only if the source is unexpected. </description>
  </rule>
  
  <rule id="100903" level="0">
    <if_sid>100900</if_sid>
    <field name="conn_state">^REJ$</field>
    <description>Zeek: Single rejected connection (Ignored)</description>
  </rule>
  
  <rule id="100904" level="10" frequency="7" timeframe="30">
    <if_matched_sid>100903</if_matched_sid>
    <same_source_ip />
    <description>Zeek: Multiple rejected connections from $(id.orig_h) - possible scan</description>
    <mitre><id>T1595</id></mitre>
  </rule>

  <rule id="100905" level="9">
    <if_sid>100900</if_sid>
    <field name="uri" type="pcre2">\.\.\/|union\s+select|alert\(|script|onerror=</field>
    <description>Zeek: Potential web exploit attempt</description>
    <mitre><id>T1190</id></mitre>
  </rule>

  <rule id="100906" level="9">
    <if_sid>100900</if_sid>
    <field name="user_agent" type="pcre2">sqlmap|nikto|nmap|havij|acunetix|masscan</field>
    <description>Zeek: Known vulnerability scanner detected</description>
  </rule>

  <rule id="100907" level="9">
    <if_sid>100900</if_sid>
    <field name="weird.name" type="pcre2">malformed|unexpected|exploit|attempt</field>
    <description>Zeek: Network anomaly/weird traffic detected</description>
  </rule>
  
  <rule id="100908" level="7" frequency="15" timeframe="60">
    <if_matched_sid>100903</if_matched_sid>
    <same_source_ip />
    <description>Zeek: Repeated connection rejections from $(id.orig_h) (Possible slow scan)</description>
    <mitre><id>T1595</id></mitre>
  </rule>

  <rule id="100909" level="10" frequency="30" timeframe="30">
    <if_matched_sid>100903</if_matched_sid>
    <same_source_ip />
    <description>Zeek: High frequency of rejections from $(id.orig_h) (Active Port Scanning/Discovery)</description>
    <mitre><id>T1595.001</id></mitre>
  </rule>
</group>
