<group name="zeek,">
  <rule id="100900" level="0">
    <decoded_as>json</decoded_as>
    <description>Zeek alerts</description>
  </rule>

  <rule id="100901" level="5">
    <if_sid>100900</if_sid>
    <field name="dnsquery">\w+.</field>
    <dstport type="pcre2">^53$</dstport>
    <field name="resolved_by">\d+.\d+.\d+.\d+</field>
    <description>Zeek: DNS Query $(dnsquery) attempted from source ip $(srcip) source port $(srcport) resolved to IP(s) $(resolved_by)</description>
  </rule>

  <rule id="100902" level="0">
    <if_sid>100900</if_sid>
    <srcport>5353</srcport>
    <description>Zeek: Normal mDNS traffic - $(dnsquery) from source ip $(srcip). Generally benign. Investigate only if the source is unexpected. </description>
  </rule>

  <rule id="100903" level="7">
    <if_sid>100900</if_sid>
    <field name="connection_state" type="pcre2">^(REJ|RSTR)$</field>
    <description>Zeek: Connection from $(srcip) to $(dstip) $(dstport) rejected</description>
  </rule>

  <rule id="100904" level="10" frequency="5" timeframe="20">
    <if_matched_sid>100903</if_matched_sid>
    <same_srcip />
    <description>Zeek possible port scan from $(id.orig_h)</description>
  </rule>

<!-- Suppresses alerts for DNS queries domain. -->
  <rule id="100905" level="0">
    <if_sid>100900</if_sid>
    <field name="dnsquery" type="pcre2">.+</field>
    <field name="id.resp_p">53</field>
    <description>Zeek DNS query $(dnsquery) from $(id.orig_h) to $(id.resp_h)</description>
  </rule>

  <rule id="100906" level="8">
    <if_sid>100900</if_sid>
    <field name="uri" type="pcre2">(\.\./|union\s+select|script|onerror=|alert\()</field>
    <description>Zeek possible web exploit attempt from $(id.orig_h) to $(id.resp_h): $(uri)</description>
  </rule>

  <rule id="100907" level="12">
    <if_sid>100900</if_sid>
    <field name="user_agent" type="pcre2">(?i)(sqlmap|nikto|masscan|nmap|acunetix|havij)</field>
    <description>Zeek scanner detected: $(user_agent) from $(id.orig_h)</description>
  </rule>
    <rule id="100913" level="0">
    <if_sid>100900</if_sid>
    <field name="id.resp_p">3389</field>
    <description>Zeek RDP connection from $(id.orig_h) to $(id.resp_h)</description>
  </rule>

  <rule id="100914" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100913</if_matched_sid>
    <same_srcip />
    <description>Zeek RDP brute force suspected from $(id.orig_h)</description>
  </rule>

  <rule id="100915" level="0">
    <if_sid>100900</if_sid>
    <field name="id.resp_p">445</field>
    <description>Zeek SMB connection from $(id.orig_h) to $(id.resp_h)</description>
  </rule>

  <rule id="100916" level="10" frequency="10" timeframe="60">
    <if_matched_sid>100915</if_matched_sid>
    <same_srcip />
    <description>Zeek SMB lateral movement suspected from $(id.orig_h)</description>
  </rule>

  <rule id="100917" level="0">
    <if_sid>100900</if_sid>
    <field name="success">true</field>
    <field name="username" type="pcre2">.+</field>
    <description>Zeek NTLM success for $(username) from $(id.orig_h)</description>
  </rule>

  <rule id="100918" level="7">
    <if_sid>100900</if_sid>
    <field name="name" type="pcre2">^(truncated_tcp_payload|dnp3_header_lacks_magic)$</field>
    <description>Zeek weird traffic detected: $(name) from $(id.orig_h)</description>
  </rule>
  
</group>
